<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The app: dark YokoTV background, no action bar, dark system bars. -->
    <style name="Theme.YokoTV" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/yoko_bg</item>
        <item name="android:colorBackground">@color/yoko_bg</item>
        <item name="android:colorAccent">@color/yoko_accent</item>
        <item name="android:colorPrimary">@color/yoko_bg</item>
        <item name="android:colorPrimaryDark">@color/yoko_bg</item>
        <item name="android:statusBarColor">@color/yoko_bg</item>
        <item name="android:navigationBarColor">@color/yoko_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
    </style>

    <!-- Launch splash (SplashScreen API, back-ported to Android 5+). -->
    <style name="Theme.YokoTV.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/yoko_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.YokoTV</item>
    </style>
</resources>
